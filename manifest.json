{
  "manifest_version": 3,
  "name": "Azure Key Vault Secret Revealer",
  "version": "1.2.0",
  "description": "Reveal, edit, create, search, export and import Key Vault secrets in the Azure Portal with your own Azure RBAC access.",
  "minimum_chrome_version": "102",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://portal.azure.com/*",
    "https://*.vault.azure.net/*",
    "https://login.microsoftonline.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Key Vault Secret Revealer"
  },
  "content_scripts": [
    {
      "matches": ["https://portal.azure.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
